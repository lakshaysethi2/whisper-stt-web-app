# whisper-stt-web-app configuration
# Copy to .env and edit:  cp .env.example .env

# --- Model ---
# Model to use: tiny, base, small, medium, large-v3, large-v3-turbo
# CPU hosts: use base or small
# GPU hosts: use large-v3-turbo (add -f docker-compose.gpu.yml)
WHISPER_MODEL=base

# Language for transcription (ISO 639-1 code, e.g. en, fr, de)
WHISPER_LANGUAGE=en

# --- Storage ---
# Maximum upload file size in bytes (default: 512 MB)
# 512 MB = 536870912   |   1 GB = 1073741824   |   2 GB = 2147483648
MAX_FILE_SIZE=536870912

# Minimum free disk threshold in bytes (default: 2 GB)
# Uploads are rejected when free space drops below this value
MIN_FREE_DISK_BYTES=2147483648

# Job retention period in seconds (default: 2 hours = 7200)
# Completed/failed transcription RESULTS remain available for resume.
# Running jobs are never cleaned up.
# JOB_RETENTION_SECONDS=7200

# Audio retention period in seconds (default: 30 minutes = 1800)
# Uploaded recordings are deleted sooner than transcripts: immediately when
# transcription completes, and at most this long for abandoned/crashed jobs.
# AUDIO_RETENTION_SECONDS=1800

# --- Networking ---
# Host port for the web app (default: 8561)
HOST_PORT=8561

# Memory limit for the container (default: 8g)
MEM_LIMIT=8g

# --- Optional: Hugging Face token (for gated models) ---
# HF_TOKEN=
