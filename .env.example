# Whisper STT Web App - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Whisper model to use (tiny, base, small, medium, large-v3, large-v3-turbo)
WHISPER_MODEL=large-v3-turbo

# Default transcription language (auto-detect if empty)
WHISPER_LANGUAGE=en

# Maximum upload file size in bytes (default: 2 GB)
# MAX_FILE_SIZE=2147483648

# Job retention period in seconds (default: 2 hours = 7200)
# Completed/failed jobs remain available for resume for this duration.
# Running jobs are never cleaned up.
# JOB_RETENTION_SECONDS=7200
