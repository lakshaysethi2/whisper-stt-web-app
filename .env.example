# whisper-stt-web-app configuration
# Copy to .env and edit:  cp .env.example .env

# --- Model ---
# Model to use: tiny, base, small, medium, large-v3, large-v3-turbo,
# or crisperwhisper-large/turbo/medium/small (verbatim ASR + word timestamps)
# CPU hosts: use base or small
# GPU hosts: use large-v3-turbo (add -f docker-compose.gpu.yml)
WHISPER_MODEL=base

# CrisperWhisper runtime backend: auto (default; resolves to transformers on
# this stack because the [ct2] extra conflicts with faster-whisper and has no
# ARM64 wheels), or force ct2/transformers.
# CRISPER_BACKEND=auto

# Default CrisperWhisper transcription mode when a request doesn't specify
# one: verbatim (word-for-word, fillers preserved) or intended (clean text).
# CRISPER_MODE=verbatim

# Language for transcription (ISO 639-1 code, e.g. en, fr, de)
WHISPER_LANGUAGE=en

# --- Local (CPU) transcription ---
# false (default): never transcribe on this host's CPU. Jobs that no GPU node
# can take fail cleanly with "No transcription node available". Set true for
# plain CPU-only single-host deployments.
# WHISPER_ALLOW_LOCAL_CPU=false

# --- Storage ---
# Maximum upload file size in bytes (default: 512 MB)
# 512 MB = 536870912   |   1 GB = 1073741824   |   2 GB = 2147483648
MAX_FILE_SIZE=536870912

# Minimum free disk threshold in bytes (default: 512 MB; must be below the
# tmpfs work-dir size or uploads trip it as soon as a job dir exists)
# Uploads are rejected when free space in WORK_DIR drops below this value
MIN_FREE_DISK_BYTES=536870912

# Job retention period in seconds (default: 1 week = 604800)
# Completed/failed transcription RESULTS remain available for resume.
# Running jobs are never cleaned up.
# JOB_RETENTION_SECONDS=604800

# Audio retention period in seconds (default: 30 minutes = 1800)
# Uploaded recordings are deleted sooner than transcripts: immediately when
# transcription completes, and at most this long for abandoned/crashed jobs.
# AUDIO_RETENTION_SECONDS=1800

# --- Networking ---
# Host port for the web app (default: 8561)
HOST_PORT=8561

# Memory limit for the container in bytes (default: 8 GiB = 8589934592)
# MEM_LIMIT=8589934592

# --- GPU worker nodes (optional) ---
# GPU workers are listed in config/nodes.yaml (preferred — see
# config/nodes.example.yaml). Legacy env fallback, comma-separated:
# WHISPER_WORKER_URLS=http://host.docker.internal:8564,http://host.docker.internal:8565
# WHISPER_WORKER_NAMES=GPU Node A,GPU Node B
# Models auto-dispatched to nodes (must fit the nodes' VRAM):
# WHISPER_GPU_MODELS=tiny,base,small
# Host address the workers are reachable at from inside the container
# (the reverse-tunnel binding on the deployment's docker bridge gateway).
# WHISPER_HOST_GATEWAY=10.99.0.1

# --- Optional: Hugging Face token (for gated models) ---
# HF_TOKEN=
