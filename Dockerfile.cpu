# CPU-only Dockerfile for whisper-stt-web-app.
#
# Suitable for ARM (e.g. Oracle A1) and x86_64 hosts without NVIDIA GPUs.
# Much smaller than the GPU variant (~500 MB vs ~2 GB).
#
# Usage:
#   docker build -f Dockerfile.cpu -t whisper-stt-web-app:cpu .
# or via docker-compose:
#   docker compose build
#   (the default docker-compose.yml uses the Dockerfile in the context;
#    override with --build-arg or switch the dockerfile: directive)
#
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# Install CPU-only torch first so pip does not pull the CUDA wheel bundle
# (nvidia-*) into a CPU-only image when resolving crisperwhisper[transformers].
# The GPU Dockerfile intentionally omits this step (CUDA torch comes from PyPI).
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

COPY app/ app/
COPY static/ static/

RUN useradd -m -s /bin/bash appuser
RUN mkdir -p /tmp/whisper-stt && chown appuser:appuser /tmp/whisper-stt
RUN mkdir -p /cache && chown appuser:appuser /cache
ENV HF_HOME=/cache
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
